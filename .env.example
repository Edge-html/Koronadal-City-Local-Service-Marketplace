# Copy to .env.local and fill in, then run `npm run dev`.
# Firebase web app configuration — project: cycu-trip-planner
#
# These are the PUBLIC client keys. They ship in the browser bundle and are not
# a secret. Access is controlled by firestore.rules, not by these values.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Private Supabase Storage for payment receipts, GCash QR codes, and worker credentials.
# Create a PRIVATE bucket named `private-files` in Supabase Storage.
# Get the URL and secret key from Project Settings -> API. Never use NEXT_PUBLIC_ here.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Required only by `npm run seed`.
# Path to a Firebase service account key (Project settings -> Service accounts ->
# Generate new private key). The Admin SDK bypasses security rules, so the seed
# script needs its own credentials rather than the public config above.
# Keep the downloaded JSON out of git — it grants full project access.
FIREBASE_SERVICE_ACCOUNT=./service-account.json

# Private server credential for Vercel API routes. Use raw or base64 JSON from
# Firebase Project settings -> Service accounts. Never prefix this with NEXT_PUBLIC_.
# Do not commit the value. Set it in Vercel Production and Preview environments.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional Infobip SMS sender for post-payment review links.
# The trial can only send to phone numbers verified in Infobip.
# Set INFOBIP_BASE_URL to your account's HTTPS API base URL, without a trailing slash.
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_SENDER=
# Public canonical URL used inside SMS review links, e.g. https://your-site.vercel.app
NEXT_PUBLIC_APP_URL=
