rules_version = '2';

// Koronadal City Local Service Marketplace — Firestore security rules.
//
// Design notes:
//  * The directory is world-readable. New public worker documents exclude
//    phone, email and verification files; legacy documents require migration.
//  * `workers` is keyed by auto-id, not by uid, so ownership is checked by
//    comparing the document's `uid` field against the caller. Jobs and ledger
//    entries denormalise `workerUid` for the same reason: it lets these rules
//    avoid a cross-document lookup on the hot read path.
//  * Review signals — verified, rating, reviewCount, wallet, referralCredits,
//    status — are not writable by the client. A worker cannot mark themselves
//    approved or grant themselves wallet credit.
//  * Reviews are immutable once written, so feedback cannot be rewritten to
//    launder a rating. RA 7394 recourse depends on that immutability.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers -------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * The caller's role, or null when there is no user document.
     *
     * get() returns null for a document that does not exist, and reading .data
     * off that null is an evaluation error, not false. An unguarded userDoc()
     * therefore made every rule that consults the role fail closed with a bare
     * permission-denied: creating a job, reading "my requests", anything
     * touching isAdmin(). That is exactly what an account with an auth record
     * but no user document experiences.
     */
    function userRole() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data.role : null;
    }

    function isAdmin() {
      return isSignedIn() && userRole() == 'admin';
    }

    function myRole() {
      return isSignedIn() ? userRole() : null;
    }

    function isWorkerRole() {
      return myRole() == 'worker' || myRole() == 'admin';
    }

    /**
     * True when the worker document being evaluated belongs to the caller.
     *
     * Reads resource.data directly instead of calling get() on the same
     * document id. A self-referential get() inside the very match block that
     * is already evaluating that document is a circular call, which Firestore
     * fails with a bare permission error rather than a usable diagnostic.
     */
    function isOwnWorkerDoc() {
      return isSignedIn() && resource.data.uid == request.auth.uid;
    }

    /**
     * True when the caller is the household or the assigned worker on the job
     * document being evaluated.
     *
     * Reads resource.data rather than calling get() on the same document id.
     * The self-referential get() was a circular call, and Firestore fails it
     * with a bare permission-denied. That is why every job read was rejected:
     * "My requests" queried jobs with a filter, each candidate document was
     * checked, and the check recursed into itself.
     */
    function isJobParty() {
      return isSignedIn()
        && (resource.data.consumerId == request.auth.uid
            || resource.data.workerUid == request.auth.uid);
    }

    /**
     * Commission the worker must already hold to cover a given labor fee.
     *
     * The 10% is taken on labor only; materials are exempt, which is what the
     * two-part quotation under RA 7394 exists to make visible.
     *
     * The one-cent subtraction is load-bearing. The app computes the locked
     * commission as money(laborFee * 0.1), rounding to two decimals, but this
     * rule compares against the raw product. For a large share of amounts the
     * rounding goes *down*: a labor fee of 12345.67 gives 1234.567, which
     * rounds to 1234.57 (fine, up), while 33333.33 gives 3333.333 rounded to
     * 3333.33, and 7 gives 0.7000000000000001 rounded to 0.7. A sweep over
     * every two-decimal fee from 0 to 20000 found over 1.2 million where the
     * rounded commission is strictly less than the raw one, so a worker
     * holding exactly what they were quoted would be denied their own quote.
     *
     * One cent is the rounding granularity, not a fudge factor, and it cannot
     * be abused: settleJob re-checks the real lock server-side against the
     * rounded amount, so the worst case is a one-cent under-funding that is
     * still caught at settlement.
     */
    function commissionFor(laborFee) {
      return laborFee * 0.1 - 0.01;
    }

    /**
     * True when the worker named on the job being evaluated has enough
     * unlocked prepaid balance to cover the commission implied by a labor fee.
     *
     * The default of 0 on a missing field is deliberate and fail-closed: a
     * worker document with no wallet fields has no money behind it, so a quote
     * it cannot cover is the correct answer.
     */
    function workerCanCoverLabor(workerId, laborFee) {
      let w = get(/databases/$(database)/documents/workers/$(workerId));
      return (w.data.get('walletBalance', 0) - w.data.get('walletLocked', 0))
        >= commissionFor(laborFee);
    }

    /**
     * The listing fields a worker is allowed to edit themselves. Anything not
     * listed here is review signal or money and is off limits to the client.
     *
     * An explicit allowlist rather than an "everything else must be unchanged"
     * check: that form silently denies valid writes whenever a document is
     * missing one of the compared fields, and it breaks the moment a field is
     * added to the schema.
     */
    function isListingOnlyEdit() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'fullName',
          'barangay',
          'serviceAreas',
          'bio',
          'specialtyDescription',
          'profileVisibility',
          'yearsExperience',
          'hourlyRate',
          'portfolio',
          'resume',
          'skills',
          'updatedAt'
        ])
        && (!('skills' in request.resource.data)
            || (request.resource.data.skills is list
                && request.resource.data.skills.size() <= 20))
        && (!('resume' in request.resource.data)
            || request.resource.data.resume == null
            || (!('rawText' in request.resource.data.resume)
                && !('phone' in request.resource.data.resume)
                && !('email' in request.resource.data.resume)
                && !('fileUrl' in request.resource.data.resume)));
    }

    // ---- users ----------------------------------------------------

    match /users/{uid} {
      // A user creates their own record during signup. Admin is NOT in this
      // list on purpose: 'admin' is the platform-wide override that unlocks
      // every collection, so allowing it here would let anyone self-promote
      // simply by posting their own user document. Admins are provisioned by
      // the Admin SDK in scripts/seed.mjs, which bypasses these rules.
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role in ['customer', 'worker'];

      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      // Edit your own record. The role may never change arbitrarily: a
      // household upgrading itself to offer services is the one legitimate
      // transition, and admin remains unreachable from the client because it
      // is not in the allowed source or target set.
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && (
          request.resource.data.role == resource.data.role
          || (
            resource.data.role == 'customer'
            && request.resource.data.role == 'worker'
          )
        );

      allow delete: if isAdmin();
    }

    // ---- workers -------------------------------------------------

    match /workers/{workerId} {
      // The public directory. An unapproved applicant stays unreadable so they
      // are never listed.
      allow read: if resource.data.verified == true
                  || isAdmin()
                  || isOwnWorkerDoc();

      // Registration creates the applicant's own profile, unverified, with a
      // clean slate for every review signal.
      allow create: if isSignedIn()
        && isWorkerRole()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.verified == false
        && request.resource.data.rating == 0
        && request.resource.data.reviewCount == 0
        && request.resource.data.jobsCompleted == 0
        && request.resource.data.walletBalance == 0
        && request.resource.data.walletLocked == 0
        && request.resource.data.referralCredits == 0
        && !('phone' in request.resource.data)
        && !('email' in request.resource.data)
        && !('verificationDocs' in request.resource.data)
        && !('resume' in request.resource.data);

      // A worker may edit their own listing. Admins may do anything.
      allow update: if isAdmin()
        || (isOwnWorkerDoc() && isListingOnlyEdit());

      allow delete: if isAdmin();
    }

    // Credential metadata is separate from the public directory record.
    match /workerCredentials/{workerId} {
      allow read: if isAdmin()
        || (isSignedIn()
            && get(/databases/$(database)/documents/workers/$(workerId)).data.uid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/workers/$(workerId)).data.uid == request.auth.uid;
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resumePrivate']));
      allow delete: if isAdmin();
    }

    // ---- offers ---------------------------------------------------
    //
    // An offer is work a worker broadcasts: "I will do this kind of work, at
    // this price, in this area". It is the mirror image of a Job, which is one
    // household asking one assigned worker for something specific.

    match /offers/{offerId} {
      // Open offers are public so households can find them. Closed ones stay
      // readable by their owner and by administrators so the worker can still
      // see the history and the inquiries it collected.
      allow read: if resource.data.status == 'open'
                  || isAdmin()
                  || (isSignedIn() && resource.data.workerUid == request.auth.uid);

      // A worker posts only as themselves. workerId must be a real string so a
      // malformed document cannot produce a collection group with no owner.
      allow create: if isSignedIn()
        && isWorkerRole()
        && request.resource.data.workerUid == request.auth.uid
        && request.resource.data.workerId is string
        && get(/databases/$(database)/documents/workers/$(request.resource.data.workerId)).data.uid
          == request.auth.uid
        && get(/databases/$(database)/documents/workers/$(request.resource.data.workerId)).data.verified
          == true
        && get(/databases/$(database)/documents/workers/$(request.resource.data.workerId)).data.status
          == 'active'
        && (!exists(/databases/$(database)/documents/serviceControls/$(get(/databases/$(database)/documents/workers/$(request.resource.data.workerId)).data.categoryId))
            || get(/databases/$(database)/documents/serviceControls/$(get(/databases/$(database)/documents/workers/$(request.resource.data.workerId)).data.categoryId)).data.enabled == true)
        && request.resource.data.status == 'open'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 2
        && request.resource.data.title.size() <= 120
        && request.resource.data.priceFrom is number
        && request.resource.data.priceFrom >= 0;

      // The worker may edit or close their own offer, but cannot re-point it
      // at a different worker document or backdate it.
      allow update: if isAdmin()
        || (
          isSignedIn()
          && resource.data.workerUid == request.auth.uid
          && request.resource.data.workerUid == request.auth.uid
          && request.resource.data.workerId == resource.data.workerId
          && request.resource.data.createdAt == resource.data.createdAt
        );

      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.workerUid == request.auth.uid);
    }

    // ---- inquiries ------------------------------------------------
    //
    // A household responding to an offer. The document id is deterministic --
    // "{offerId}_{consumerId}" -- so the one-response-per-household rule is
    // enforced by the write itself rather than by a query the client could
    // race. An auto-id could not express that at all: there is no field holding
    // the generated id, so `exists()` would have nothing to check.

    match /inquiries/{inquiryId} {
      // The worker who received it and the household who sent it, and nobody
      // else. Reads workerUid off the document rather than looking the worker
      // profile up: a get() here would put a cross-document read on the path
      // of every inquiry the worker console lists.
      allow read: if isAdmin()
        || (
          isSignedIn()
          && (
            resource.data.workerUid == request.auth.uid
            || resource.data.consumerId == request.auth.uid
          )
        );

      allow create: if isSignedIn()
        && request.resource.data.consumerId == request.auth.uid
        && request.resource.data.workerUid is string
        && request.resource.data.workerId is string
        && request.resource.data.offerId is string
        && inquiryId == request.resource.data.offerId + '_' + request.auth.uid
        && !exists(/databases/$(database)/documents/inquiries/$(inquiryId))
        && get(/databases/$(database)/documents/offers/$(request.resource.data.offerId)).data.status == 'open'
        && get(/databases/$(database)/documents/offers/$(request.resource.data.offerId)).data.workerUid
          == request.resource.data.workerUid
        && get(/databases/$(database)/documents/offers/$(request.resource.data.offerId)).data.workerId
          == request.resource.data.workerId;

      // Once sent, an inquiry is a record of what was said. Editing it would
      // undermine the one-review-per-job reasoning that applies here too.
      allow update, delete: if false;
    }

    // ---- private direct messages ---------------------------------
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
        && request.resource.data.consumerId == request.auth.uid
        && request.resource.data.workerUid is string
        && request.resource.data.workerUid != request.auth.uid
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants.hasAll([request.auth.uid, request.resource.data.workerUid])
        && get(/databases/$(database)/documents/workers/$(request.resource.data.workerId)).data.uid == request.resource.data.workerUid
        && get(/databases/$(database)/documents/workers/$(request.resource.data.workerId)).data.verified == true
        && get(/databases/$(database)/documents/workers/$(request.resource.data.workerId)).data.status == 'active';
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt'])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 240;
      allow delete: if false;

      match /messages/{messageId} {
        function isConversationParty() {
          let thread = get(/databases/$(database)/documents/conversations/$(conversationId));
          return isSignedIn() && request.auth.uid in thread.data.participants;
        }
        allow read: if isConversationParty();
        allow create: if isConversationParty()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 2000;
        allow update, delete: if false;
      }
    }
    // ---- jobs -----------------------------------------------------

    match /jobs/{jobId} {
      allow read: if isJobParty() || isAdmin();

      // A household opens a request against a verified, active worker.
      // Workers are permitted too: the two consoles are switchable, so a
      // worker acting as a household must be able to post a request.
      allow create: if isSignedIn()
        && myRole() in ['customer', 'worker']
        && request.resource.data.consumerId == request.auth.uid
        && request.resource.data.status == 'requested'
        && request.resource.data.workerUid != request.auth.uid
        && request.resource.data.workerId is string
        && request.resource.data.workerUid is string
        && get(/databases/$(database)/documents/workers/$(request.resource.data.workerId)).data.uid
          == request.resource.data.workerUid
        && get(/databases/$(database)/documents/workers/$(request.resource.data.workerId)).data.verified
          == true
        && get(/databases/$(database)/documents/workers/$(request.resource.data.workerId)).data.status
          == 'active'
        && (!exists(/databases/$(database)/documents/serviceControls/$(get(/databases/$(database)/documents/workers/$(request.resource.data.workerId)).data.categoryId))
            || get(/databases/$(database)/documents/serviceControls/$(get(/databases/$(database)/documents/workers/$(request.resource.data.workerId)).data.categoryId)).data.enabled == true)
        && (
          request.resource.data.barangay == get(/databases/$(database)/documents/workers/$(request.resource.data.workerId)).data.barangay
          || request.resource.data.barangay in get(/databases/$(database)/documents/workers/$(request.resource.data.workerId)).data.get('serviceAreas', [])
        );

      // Each client may make only its own next step. Money and review
      // transitions are performed by the authenticated server transaction.
      allow update: if isSignedIn()
        && request.resource.data.consumerId == resource.data.consumerId
        && request.resource.data.workerId == resource.data.workerId
        && request.resource.data.workerUid == resource.data.workerUid
        && (
          (request.auth.uid == resource.data.workerUid
            && resource.data.status == 'requested'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'cancelledAt', 'cancelReason']))
          || (request.auth.uid == resource.data.workerUid
            && resource.data.status == 'accepted'
            && request.resource.data.status == 'quoted'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'quote', 'quotedAt'])
            // A quote the worker cannot fund is a quote no household could ever
            // approve: approveQuote locks this same commission out of the
            // worker's balance transactionally and throws if it is short. Left
            // unchecked the worker submits it, the household clicks Approve,
            // and hits a dead end on someone else's wallet balance, with no
            // warning beforehand and nothing to act on afterwards. Refuse the
            // quote here instead, where the worker can still do something
            // about it.
            && request.resource.data.quote is map
            && request.resource.data.quote.laborFee is number
            && request.resource.data.quote.laborFee > 0
            && workerCanCoverLabor(
                 resource.data.workerId,
                 request.resource.data.quote.laborFee))
          || (request.auth.uid == resource.data.workerUid
            && resource.data.status == 'in_progress'
            && request.resource.data.status == 'completed'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'completedAt']))
          || ((request.auth.uid == resource.data.workerUid
               || request.auth.uid == resource.data.consumerId)
            && resource.data.status in ['accepted', 'quoted', 'in_progress', 'completed']
            && request.resource.data.status == 'disputed'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status']))
        );

      allow delete: if isAdmin();
    }

    // ---- reviews --------------------------------------------------

    match /reviews/{reviewId} {
      // Readable by anyone browsing a profile.
      allow read: if true;

      // The server verifies the settled job and creates one review atomically.
      allow create: if false;

      // Immutable once submitted, so feedback cannot be rewritten to launder
      // a rating. RA 7394 recourse depends on that.
      allow update, delete: if isAdmin();
    }

    // ---- ledger ---------------------------------------------------

    match /ledger/{entryId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.workerUid == request.auth.uid);

      // Append-only. Authenticated server transactions create entries.
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // ---- top-up requests -----------------------------------------
    match /topupRequests/{requestId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.workerUid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.workerUid == request.auth.uid
        && request.resource.data.workerId is string
        && request.resource.data.status == 'pending'
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 100000
        && request.resource.data.method in ['gcash', 'cliqq']
        && request.resource.data.reference is string
        && request.resource.data.reference.size() >= 4
        && request.resource.data.receiptPath is string
        && request.resource.data.receiptPath.matches('topup-receipts/' + request.auth.uid + '/[A-Za-z0-9-]+');
      allow update, delete: if isAdmin();
    }

    // Payment destination details are visible to signed-in workers. Changes
    // go through the authenticated Admin SDK route so clients cannot replace
    // the platform's GCash number or QR code.
    match /platformSettings/payments {
      allow read: if isWorkerRole();
      allow write: if false;
    }

    // ---- disputes -------------------------------------------------

    match /disputes/{disputeId} {
      allow read: if isSignedIn()
        && (resource.data.consumerId == request.auth.uid
            || resource.data.workerUid == request.auth.uid
            || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.jobId is string
        && (get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.consumerId == request.auth.uid
            || get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.workerUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
